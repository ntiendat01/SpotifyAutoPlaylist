<?xml version="1.0" encoding="utf-8"?>
<!-- Hero card look from the new UI: dark emerald gradient, bounded top-right glow, Stroke border. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="@color/widget_hero_start"
                android:endColor="@color/widget_hero_end" android:type="linear" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="1" android:centerY="0"
                android:gradientRadius="75%p" android:startColor="@color/widget_glow"
                android:endColor="@color/widget_glow_end" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/widget_stroke" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
</layer-list>
